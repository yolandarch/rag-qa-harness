# Salin menjadi .env lalu isi. JANGAN commit .env.
# Semua endpoint memakai format API yang kompatibel dengan OpenAI.

# Generator (menjawab pertanyaan)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=isi-api-key
LLM_MODEL=openai/gpt-oss-120b

# Embedding (ingest & query)
EMB_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMB_API_KEY=isi-api-key

# Judge (sebaiknya beda keluarga model dengan generator)
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=isi-api-key
JUDGE_MODEL=gemini-3.5-flash
